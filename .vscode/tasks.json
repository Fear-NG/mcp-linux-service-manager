{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (make)",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean (make clean)",
      "type": "shell",
      "command": "make clean",
      "problemMatcher": []
    },
    {
      "label": "Rebuild",
      "type": "shell",
      "command": "make clean && make",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Server",
      "type": "shell",
      "command": "./mcp-service-manager",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "Build & Run",
      "type": "shell",
      "command": "make && ./mcp-service-manager",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    }
  ]
}
